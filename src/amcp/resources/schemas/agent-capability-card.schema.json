{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "agent-capability-card",
  "required": [
    "agent_id",
    "roles",
    "read_scopes",
    "write_modes",
    "write_sources",
    "forbidden"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "roles": {
      "type": "array"
    },
    "read_scopes": {
      "type": "array"
    },
    "write_modes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "write_sources": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "forbidden": {
      "type": "array"
    }
  }
}
